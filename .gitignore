# Agent instructions can hold sensitive details (kept out of the repo by rule)
CLAUDE.md

# Secrets and local config
.env
*.local.conf
*.local.toml

# Recordings of real people and generated audio stay out of the repo
samples/
*.wav
*.m4a
*.mp3

# Raw corpus downloads are reproducible from corpus/SOURCES.md; processed text is committed
corpus/raw/

# Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store
.pytest_cache/

# Local log files written when local_logs is on (the service logs to journald)
logs/

# Downloaded resources (NLTK data, lexicons); each machine fetches its own
data/

# editor swap files
*.swp
*.swo
*.swn

# server logs written by the experiments' bake-off runners
experiments/**/server-*.log
