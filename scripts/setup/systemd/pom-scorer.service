# The Scorer's llama-server (Qwen3-4B): scores one sentence at a time. Linked into /etc/systemd/system by scripts/setup/install-services.sh.
# The model stays loaded (the design: whisper, the scorer and the oracle are all resident at once on the 16 GB Pi): -lm mmap maps it and -lzm off
# keeps every tensor resident. Measured on the Pi 2026-11-03: that leaves about 7 GB available with all three running. NOT pinned (-lm mmap+mlock):
# this ARM build keeps a repacked copy of the weights, so pinning the mapped file as well uses the memory twice and left under 1 GB available. The port is [scorer] url; -np 2 and -t 4 are what the Pi was benchmarked with.
[Unit]
Description=Printer of Mysteries: the Scorer's llama-server (Qwen3-4B)

[Service]
User=pi
WorkingDirectory=/home/pi/pom
ExecStart=/home/pi/pom/data/tools/llama.cpp/build/bin/llama-server -m /home/pi/pom/data/models/Qwen3-4B-Q4_K_M.gguf --host 127.0.0.1 --port 8098 --ctx-size 4096 -np 2 --jinja -t 4 -lm mmap -lzm off
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
